; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ThaHood3D"
run/main_scene="uid://ba01ixnwmh018"
config/features=PackedStringArray("4.8", "GL Compatibility")

[autoload]

MainNetwork="*uid://b0jywbr17oejo"

[debug]

gdscript/warnings/inferred_declaration=1

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="ThaHood3D"

[editor]

movie_writer/ogv/encoding_speed=1
movie_writer/movie_file="/home/kartikey/Videos/Godot_Movies/movie_main.avi"
movie_writer/disable_vsync=true

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
"res://animations/": "purple",
"res://animations_extra/": "purple",
"res://characters/": "red",
"res://docs/": "gray",
"res://levels/": "orange",
"res://models/": "yellow",
"res://sounds/": "pink",
"res://textures/": "green",
"res://trash/": "gray"
}

